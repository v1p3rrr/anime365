# Сгенерировано из backend/app/core/settings_registry.py — не правьте вручную.
# Приоритет: значение по умолчанию < эта переменная < правка в UI.

# --- api ---
# Выбирается из списка известных зеркал. embed всегда возвращает ссылки на smotret-anime.org,
# поэтому хост ссылок скачивания переписывается на выбранный.
A365_BASE_URL=https://smotret-anime.app

# Через запятую. Задаётся только на сервере: из UI не меняется — это защита от SSRF.
A365_MIRRORS=https://smotret-anime.app,https://smotret-anime.org,https://smotret-anime.online,https://smotret-anime.net

# Токен аккаунта с премиум-подпиской. Нужен для скачивания видео. Бессрочный.
A365_ACCESS_TOKEN=

# Документация API просит указывать название программы.
A365_USER_AGENT=Anime365Downloader/1.0

# Явного лимита у API не замечено, но ограничитель страхует от бана.
A365_REQUEST_RATE_LIMIT=5

# --- paths ---
# Внутри контейнера. Все целевые пути проверяются как потомки этого корня.
A365_SERIES_ROOT=/media/anime/library

# Куда складываются фильмы. Отдельно от сериалов: Jellyfin держит для них разные библиотеки.
A365_MOVIES_ROOT=/media/anime_movies/library

# Отдельный корень для извлечённых звуковых дорожек. В библиотеку они не кладутся: Jellyfin
# индексировал бы их как видео без картинки.
A365_AUDIO_ROOT=/media/anime_audio

# Желательно внутри того же монтирования, что библиотека: тогда готовый файл не копируется, а
# переименовывается — мгновенно и независимо от размера. Решает именно монтирование, а не диск
# и даже не файловая система: два отдельных тома docker с одной хостовой папки ядро считает
# разными монтированиями, и перемещение между ними идёт копированием. Практически это значит,
# что папку загрузок лучше держать подпапкой внутри уже примонтированной медиатеки, а не
# отдельным томом.
A365_DOWNLOAD_TMP=/media/.a365-tmp

# --- downloads ---
# 0 — без ограничения.
A365_MAX_CONCURRENT_DOWNLOADS=1

# 1080 — фактически максимум: даже у 4K-источников ступени скачивания ограничены 1080. Если
# ступени нет, берётся максимальная доступная ниже.
A365_PREFERRED_HEIGHT=1080

# Сколько раз повторять неудачную задачу, прежде чем пометить её ошибкой.
A365_MAX_ATTEMPTS=5

# Пауза между попытками растёт экспоненциально от этого значения.
A365_RETRY_BACKOFF_BASE=30

# Задача не стартует, если на любом из двух томов останется меньше: проверяются и временная
# папка, и папка библиотеки — обычно это разные монтирования, и файл переезжает между ними
# после загрузки.
A365_MIN_FREE_SPACE_GB=10

# 0 — без ограничения.
A365_SPEED_LIMIT_KBPS=0

# Экспериментально. Ссылки идут через nginx-прокси перед BunnyCDN; прямой хост на тестовом
# файле был быстрее в 5.6 раза, но на реальном видео это не подтверждено. При любой ошибке —
# автоматический откат на обычную ссылку.
A365_TRY_DIRECT_CDN=false

# --- schedule ---
# Новые тайтлы по afterId плюс обновление онгоингов. Онгоингов несколько сотен, так что проход
# занимает секунды.
A365_CATALOG_REFRESH_HOURS=1

# Перечитывает весь каталог. У тайтлов нет updatedDateTime, поэтому правки существующих
# записей ловятся только полным рескaном — инкремент видит лишь новые.
A365_CATALOG_FULL_REFRESH_HOURS=24

# Инкрементально по mtime. При включённом слежении за файловой системой это только страховка
# (пропущенные события, сетевые ФС, простой контейнера), поэтому интервал большой. Без
# слежения — основной механизм, ставьте 4-6.
A365_LIBRARY_SCAN_HOURS=24

# Библиотека обновляется в UI сразу после появления файлов, а не по расписанию. Стоит
# недорого: следим за каталогами, а не файлами, это ~1 КБ памяти ядра на каталог. НЕ работает
# на сетевых ФС (NFS, SMB) — там события от других хостов не доставляются; в этом случае
# автоматически откатываемся на расписание.
A365_WATCH_FILESYSTEM=true

# Копирование одного файла порождает десятки событий. Ждём тишины по папке указанное время и
# только потом пересканируем её — иначе будем дёргаться на каждый чанк записи.
A365_WATCH_DEBOUNCE_SECONDS=10

# --- matching ---
# Оценка похожести названий 0..100, выше которой связь создаётся без подтверждения.
A365_FUZZY_AUTO_THRESHOLD=88

# Ниже автоматического: попадает в «предложения» и требует подтверждения в UI.
A365_FUZZY_SUGGEST_THRESHOLD=75

# --- files ---
# Должен совпадать с владельцем медиабиблиотеки, иначе Jellyfin не прочитает скачанное.
# Узнать: id -u
A365_PUID=1000

# Группа владельца создаваемых файлов. Узнать: id -g
A365_PGID=1000

# Восьмеричная маска прав для создаваемых файлов и папок, например 022.
A365_UMASK=022

# --- security ---
# Имя, под которым вы входите. Пользователь с этим именем заводится при старте и всегда
# остаётся администратором, чтобы снятая галочка не заперла вас снаружи. Пароль ему задаёт
# соседняя настройка.
A365_ADMIN_LOGIN=admin

# Пусто — вход открыт (UI покажет предупреждение). Выставлять сервис наружу без пароля нельзя:
# через UI доступен ваш премиум-токен и запись в файловую систему.
A365_UI_PASSWORD=

# --- features ---
# Зачем: чтобы в подсказке к серии было видно, на каком языке звук у скачанного файла, и чтобы
# панель загрузки не предлагала то, что у вас уже есть. Обычно не нужно — Jellyfin пишет
# список дорожек в <streamdetails> внутри .nfo, и оттуда это берётся бесплатно. Включайте,
# если у файлов нет .nfo. Работает фоновой джобой и запоминает результат: проверенный файл
# повторно не открывается. Цена — открытие каждого файла (читается заголовок, 0.37 МБ из 37),
# поэтому на медленном диске лучше держать выключенным.
A365_ENABLE_FFPROBE=false

# Что даёт: после раскладки файлов просит Jellyfin пересканировать библиотеку, показывает на
# странице тайтла кнопку «Смотреть в Jellyfin», позволяет собирать коллекции и сверять, какие
# наши файлы Jellyfin у себя не распознал. Тайтл ищется у него по пути к папке, поэтому
# настраивать сопоставление не нужно.
A365_ENABLE_JELLYFIN=false

# Куда ходит само приложение. Задаётся только на сервере: A365_JELLYFIN_URL. В docker это имя
# контейнера, например http://jellyfin:8096 — не IP: адрес в docker-сети переживёт не каждый
# перезапуск.
A365_JELLYFIN_URL=

# По умолчанию выключено: к Jellyfin ходим напрямую, минуя HTTP_PROXY и ALL_PROXY из
# окружения. Так и надо, когда Jellyfin — соседний контейнер: имени вроде jellyfin в NO_PROXY
# обычно нет, и запрос уходил во внешний прокси, который отвечал 503, а до самого Jellyfin не
# доходило ничего. Включайте, если Jellyfin стоит в интернете и добраться до него можно только
# через прокси.
A365_JELLYFIN_VIA_PROXY=false

# Куда ведут ссылки, по которым вы кликаете в браузере, например https://jellyfin.example.com.
# Задаётся только на сервере: A365_JELLYFIN_PUBLIC_URL. Оставьте пустым, если Jellyfin не за
# обратным прокси — тогда берётся внутренний адрес.
A365_JELLYFIN_PUBLIC_URL=

# Заводится в самом Jellyfin: Панель управления → Дополнительно → API-ключи. Без него доступен
# только адрес сервера, всё остальное закрыто.
A365_JELLYFIN_API_KEY=

# --- только через окружение, в интерфейсе этих полей нет ---

# Как часто фоновая джоба обходит тайтлы и запоминает, какие типы перевода есть на сайте.
# Нужно для фильтра «покажи тайтлы с японскими субтитрами»: серверного фильтра по типу
# перевода в API нет, узнать можно только запросом на каждый тайтл. 0 отключает джобу целиком.
A365_TRANSLATION_SCAN_HOURS=24

# Запросов в минуту у этой джобы. Вдвое медленнее наблюдавшегося безопасного темпа: фоновой
# задаче спешить некуда, а нарваться на лимит не хочется. Считается отдельно от
# request_rate_limit — тот про запросы, которых ждёт человек.
A365_TRANSLATION_SCAN_RPM=30

# Кого обходить: library — только тайтлы, привязанные к папкам библиотеки (сотни, минуты);
# catalog — весь каталог (29 тысяч, первый проход — часы).
A365_TRANSLATION_SCAN_SCOPE=library

# Прокси для всех исходящих запросов к Anime365 — каталог, embed, скачивание, проксирование
# видео и субтитров в плеер. Весь трафик к сайту идёт по https, поэтому обычно достаточно
# одной этой переменной. Работают и HTTP_PROXY, и NO_PROXY — стандартные, те же, что понимают
# curl и requests.
# HTTPS_PROXY=

# Прокси для всех схем сразу; сюда пишут SOCKS5. Предпочтительно socks5h:// — с разрешением
# имён на стороне прокси, иначе DNS-запросы уйдут мимо VPN и блокировка по имени останется в
# силе.
# ALL_PROXY=
