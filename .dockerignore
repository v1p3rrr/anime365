# Что НЕ уезжает в контекст сборки.
#
# Контекст — это всё, что `docker build .` отправляет демону перед первой
# инструкцией. Без этого файла туда попадали `temp/` с настоящей библиотекой и
# `data/` с базой каталога: гигабайты, которые копируются на каждую сборку и
# ни в один слой не входят.
#
# Вторая причина важнее первой: в контекст попадал и `.env` с токенами. В образ
# он не переносится — его никто не COPY-ит, — но лежать в контексте секретам
# незачем, а одна невнимательная `COPY . .` в будущем стоила бы токена
# (правило №0 в CLAUDE.md).

# --- секреты и локальная конфигурация ---
.env
.env.*
# Из config/ в образ едет ровно один файл — правила разбора имён. Остальное
# (settings.yaml, session_secret) заводится на месте и содержит секреты,
# поэтому список белый, а не чёрный: новый файл в config/ по умолчанию
# останется снаружи.
config/*
!config/filename_rules.yaml

# --- данные и личное ---
data/
temp/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
logs/
*.log

# --- репозиторий и документация ---
.git/
.gitignore
.github/
.claude/
claude/
docs/
scripts/
*.md

# --- то, что собирается внутри образа ---
frontend/node_modules/
frontend/public/libass/
frontend/dist/
backend/app/static/
backend/tests/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/

# --- разное ---
docker-compose.yml
.vscode/
.idea/
