# --- Секреты и локальная конфигурация ---
.env
.env.local
config/settings.yaml          # оверрайды из UI, у каждого свои
config/session_secret
*.token

# --- Данные приложения ---
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# Собранная статика: Vite кладёт её внутрь backend-пакета, в образе она
# генерируется на этапе сборки. package-lock.json при этом коммитим — он нужен
# для воспроизводимой сборки.
backend/app/static/

# --- Логи и временное ---
logs/
*.log
tmp/
.DS_Store
Thumbs.db

# --- IDE ---
.idea/
.vscode/
*.swp
