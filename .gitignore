# --- Секреты и локальная конфигурация ---
.env
.env.local
# Настройки приложения, в том числе access_token: compose читает их через env_file.
.env.app
# Оверрайды из UI, у каждого свои. ⚠️ Комментарий обязан стоять на ОТДЕЛЬНОЙ
# строке: git не поддерживает хвостовые комментарии, и `путь # текст` считается
# одним литеральным именем файла — шаблон перестаёт совпадать с чем бы то ни было.
config/settings.yaml
config/session_secret
*.token

# --- Данные приложения ---
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
node_modules/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*

# Собранная статика: Vite кладёт её внутрь backend-пакета, в образе она
# генерируется на этапе сборки. package-lock.json при этом коммитим — он нужен
# для воспроизводимой сборки.
backend/app/static/

# --- Логи и временное ---
logs/
*.log
tmp/
.DS_Store
Thumbs.db

# Выгрузки файловых деревьев библиотеки: используются для настройки правил
# парсинга имён, но это личные данные пользователя и в репозиторий не идут.
temp/

# --- IDE ---
.idea/
.vscode/
*.swp
.claude

# Копия libass-wasm, раскладывается скриптом перед сборкой (см. scripts/copy-libass.mjs)
frontend/public/libass/
